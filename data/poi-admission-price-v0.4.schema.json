{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melbourne-tripagent.local/schemas/poi-admission-price-v0.4.schema.json",
  "title": "Melbourne TripAgent POI admission price snapshot v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshotVersion", "currency", "verifiedAt", "records"],
  "properties": {
    "snapshotVersion": { "const": "poi-admission-price-v0.4" },
    "currency": { "const": "AUD" },
    "verifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "records": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticketType", "minCents", "maxCents", "eligibilityText"],
      "properties": {
        "ticketType": { "enum": ["adult", "child", "concession"] },
        "minCents": { "type": ["integer", "null"], "minimum": 0 },
        "maxCents": { "type": ["integer", "null"], "minimum": 0 },
        "eligibilityText": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceUrl", "sourceTitle", "authority", "retrievedAt", "effectiveFrom", "effectiveUntil", "reviewAfter"],
      "properties": {
        "sourceUrl": { "type": "string", "pattern": "^https://" },
        "sourceTitle": { "type": "string", "minLength": 1 },
        "authority": { "const": "official" },
        "retrievedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "effectiveFrom": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "effectiveUntil": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reviewAfter": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["poiId", "currency", "basis", "tiers", "displayText", "inclusions", "exclusions", "bookingRequired", "includedByDefault", "verificationStatus", "evidence"],
      "properties": {
        "poiId": { "type": "string", "pattern": "^mel-[a-z0-9-]+$" },
        "currency": { "enum": ["AUD", null] },
        "basis": { "enum": ["free_general_entry", "not_ticketed_public_space", "paid_fixed", "paid_from", "paid_range", "event_dependent", "unknown"] },
        "tiers": { "type": "array", "items": { "$ref": "#/$defs/tier" } },
        "displayText": { "type": "string", "minLength": 1 },
        "inclusions": { "type": "array", "items": { "type": "string" } },
        "exclusions": { "type": "array", "items": { "type": "string" } },
        "bookingRequired": { "type": ["boolean", "null"] },
        "includedByDefault": { "type": "boolean" },
        "verificationStatus": { "enum": ["verified_current", "verified_time_bounded", "review_due", "stale", "conflicted", "unknown"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    }
  }
}
