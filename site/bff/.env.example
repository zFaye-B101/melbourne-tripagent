LLM_ENABLED=true
LLM_PROVIDER=zhipu
LLM_RUNTIME_ENV=local
LLM_LOCAL_DEV_BYPASS_RATE_LIMITER=true
ALLOWED_ORIGINS=http://localhost:3000

# Recommended free demo provider. Copy this file to bff/.dev.vars, then set the
# key only in that ignored local file. Never paste a real key into source code.
ZHIPU_MODEL=glm-4.7-flash
ZHIPU_API_KEY=

# Alternative paid provider. Change LLM_PROVIDER to deepseek to use it.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Existing optional provider. Change LLM_PROVIDER to openai to use it.
OPENAI_MODEL=
OPENAI_API_KEY=

# Local-only Alibaba Cloud Bailian Qwen adapter (no base URL override).
DASHSCOPE_MODEL=qwen3.8-flash
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_API_KEY=
DASHSCOPE_FREE_TIER_ONLY_CONFIRMED=false
